# ============= SPA Routing =============
# Redirect all non-file requests to index.html for React Router
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS in production when the certificate is assigned.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Priorizar index.php sobre index.html para que el shim de meta tags
  # (overrides por host para preview de WhatsApp/Facebook/etc.) siempre
  # se ejecute en la raíz "/". Sin esto Apache sirve index.html
  # directamente y el RewriteRule de abajo nunca dispara para "/".
  DirectoryIndex index.php index.html

  # If the request is not a file or directory, serve index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/
  # Se rutea a index.php (shim que sustituye meta tags por host para
  # que el preview de WhatsApp/Facebook/Twitter/LinkedIn muestre la
  # imagen y descripción correcta del torneo). El shim sirve el mismo
  # index.html de la SPA cuando no hay override registrado.
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# ============= Transport Security =============
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ============= MIME Types =============
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
</IfModule>

# ============= Compression =============
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ============= Protect API credentials =============
<FilesMatch "credentials\.php$">
  Order Allow,Deny
  Deny from all
</FilesMatch>
